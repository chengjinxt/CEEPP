{
  "name": "ceepp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "pnpm run test:unit && pnpm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "build": "vite build",
    "crawl": "tsx apps/crawler/src/cli.ts",
    "deploy": "tsx scripts/deploy.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^27.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  }
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["@cloudflare/workers-types", "node", "vitest/globals"]
  },
  "include": [
    "apps/worker/src/**/*.ts",
    "apps/worker/tests/**/*.ts",
    "apps/crawler/src/**/*.ts",
    "apps/crawler/tests/**/*.ts",
    "packages/shared/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/config/**/*.ts",
    "vitest.worker.config.ts"
  ]
}
